# Copy to .env and fill in. NEVER commit .env.

# --- Database (Prisma 7 reads this via prisma.config.ts) ---
DATABASE_URL="file:./prisma/dev.db"

# --- Anthropic ---
# Model is pinned to claude-opus-5 in code; this is just the key.
ANTHROPIC_API_KEY="sk-ant-..."

# --- Razorpay (TEST MODE ONLY — Dashboard > Settings > API Keys) ---
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Mandate signing ---
# HMAC key for signing mandates. Generate: openssl rand -hex 32
MANDATE_SIGNING_KEY=""

# --- Demo controls (see BLUEPRINT.md section 17) ---
# scripted = replay a recorded agent turn sequence through the REAL policy engine,
# so the guardrail genuinely fires but the agent's choices are deterministic on camera.
DEMO_MODE="live"          # live | scripted
FORCE_ATTEMPT="false"     # true = make the agent attempt the out-of-bounds purchase
