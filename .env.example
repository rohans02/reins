# Copy to .env and fill in. NEVER commit .env.

# --- Database (Prisma 7 reads this via prisma.config.ts) ---
DATABASE_URL="file:./prisma/dev.db"

# --- Model provider (optional) ---
# With no key set, the agent runs from a scripted sequence and everything else
# stays real. Gemini is preferred when both are present, because it has a free
# tier. Force one with AGENT_PROVIDER=gemini|anthropic.
#
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Override if a newer free-tier flash model is available.
GEMINI_MODEL=""

# Vertex AI instead of the API key. Billed to the GCP project, not free tier.
# Requires: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="global"

# Anthropic (alternative): https://console.anthropic.com
ANTHROPIC_API_KEY=""

AGENT_PROVIDER=""

# --- Razorpay (TEST MODE ONLY — Dashboard > Settings > API Keys) ---
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Mandate signing ---
# HMAC key for signing mandates. Generate: openssl rand -hex 32
MANDATE_SIGNING_KEY=""

# --- Demo controls (see BLUEPRINT.md section 17) ---
# scripted = replay a recorded agent turn sequence through the REAL policy engine,
# so the guardrail genuinely fires but the agent's choices are deterministic on camera.
DEMO_MODE="scripted"      # scripted | live. Scripted is the default and always
                          # wins over any key below. Live is opt-in: it spends a
                          # real model call and creates real Razorpay orders on
                          # every Run agent click.
FORCE_ATTEMPT="false"     # true = make the agent attempt the out-of-bounds purchase

# ---------------------------------------------------------------------------
# AUTHENTICATION (optional)
#
# Leave every value below blank and the app runs on demo identities, with a
# switcher in the sidebar, exactly as it does today. Ownership is enforced
# identically either way — what changes is whether the identity is proven or
# merely asserted.
#
# Set a provider's pair and sign-in becomes required.
#   AUTH_SECRET   openssl rand -hex 32   (or: npx auth secret)
#   GitHub        github.com > Settings > Developer settings > OAuth Apps
#                 callback: http://localhost:3000/api/auth/callback/github
#   Google        console.cloud.google.com > APIs & Services > Credentials
#                 callback: http://localhost:3000/api/auth/callback/google
# ---------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
